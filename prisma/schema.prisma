// Kings Body Empire — data model
// Run `npm run db:migrate` (dev) or `npm run db:deploy` (production) after editing.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  COACH
  ADMIN
}

enum Rank {
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CLIENT)
  rank         Rank     @default(BRONZE)
  createdAt    DateTime @default(now())

  workoutLogs      WorkoutLog[]
  foodLogs         FoodLog[]
  measurementLogs  MeasurementLog[]
  packagePurchases PackagePurchase[]
  bookPurchases    BookPurchase[]
  callBookings     CallBooking[]
  resetTokens      PasswordResetToken[]
}

/// Single-use, hashed password-reset tokens. Only a SHA-256 hash is stored, so
/// a database leak cannot be replayed to take over an account.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model WorkoutLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise String
  sets     Int
  reps     Int
  weightKg Float?
  loggedAt DateTime @default(now())

  @@index([userId, loggedAt])
}

model FoodLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  calories    Int?
  loggedAt    DateTime @default(now())

  @@index([userId, loggedAt])
}

model MeasurementLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg   Float?
  heightCm   Float?
  waistCm    Float?
  shoulderCm Float?
  chestCm    Float?
  armCm      Float?
  loggedAt   DateTime @default(now())

  @@index([userId, loggedAt])
}

model Package {
  id              String            @id @default(cuid())
  title           String
  slug            String            @unique
  description     String
  durationWeeks   Int
  priceKobo       Int
  previewVideoUrl String?
  contents        String[]
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  purchases       PackagePurchase[]
}

model PackagePurchase {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId   String
  package     Package       @relation(fields: [packageId], references: [id])
  amountKobo  Int
  paystackRef String        @unique
  status      PaymentStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([userId])
  @@index([status])
}

model Book {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String?
  priceKobo   Int
  fileUrl     String
  coverUrl    String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  purchases   BookPurchase[]
}

model BookPurchase {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId      String
  book        Book          @relation(fields: [bookId], references: [id])
  amountKobo  Int
  paystackRef String        @unique
  status      PaymentStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([userId])
  @@index([status])
}

model EducationContent {
  id           String   @id @default(cuid())
  title        String
  category     String
  videoUrl     String
  thumbnailUrl String?
  createdAt    DateTime @default(now())

  @@index([category])
}

model CoachAvailability {
  id        String       @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean      @default(false)
  booking   CallBooking?

  @@index([startTime])
}

model CallBooking {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotId    String            @unique
  slot      CoachAvailability @relation(fields: [slotId], references: [id])
  phone     String?
  notes     String?
  createdAt DateTime          @default(now())

  @@index([userId])
}
