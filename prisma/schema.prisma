// Kings Body Empire — data model
// Run `npm run db:migrate` (dev) or `npm run db:deploy` (production) after editing.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  COACH
  ADMIN
}

enum Rank {
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

/// Programs are billed monthly through a Paystack Plan; e-books are one-off.
enum BillingInterval {
  MONTHLY
  ONE_OFF
}

enum ReferralStatus {
  /// Signed up with someone's code, no payment yet.
  PENDING
  /// Paid their first program charge.
  QUALIFIED
  /// Reward days applied to both sides.
  REWARDED
}

enum SubscriptionStatus {
  /// Paid and renewing.
  ACTIVE
  /// Cancelled by the client but paid up to `currentPeriodEnd`.
  NON_RENEWING
  /// A renewal charge failed — access continues for a short grace period.
  PAST_DUE
  /// Cancelled and finished, or the plan was disabled.
  CANCELLED
  /// Paystack has stopped billing and the paid period is over.
  COMPLETE
}

/// Home-visit / remote consultations offered by the doctor-led side of the
/// platform. Flat fee; payment is collected on the call or at the visit, so
/// there is no `paystackRef` — booking is a request, not a charge.
enum ConsultationSpecialty {
  FITNESS_COACH
  DIETICIAN
  NUTRITIONIST
  CARDIOLOGIST
  DIABETOLOGIST_ENDOCRINOLOGIST
  NEUROLOGIST
}

enum ConsultationMode {
  /// Video or phone call from home.
  VIDEO
  /// The doctor/coach travels to the client's address.
  HOME_VISIT
}

enum ConsultationStatus {
  /// Request received — the studio confirms by phone/WhatsApp.
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CLIENT)
  rank         Rank     @default(BRONZE)
  createdAt    DateTime @default(now())

  /// Shareable code used in /?ref=CODE. Generated on first visit to the dashboard.
  referralCode      String?  @unique
  /// Set once, at signup, when the account was created through someone's link.
  referredById      String?
  referredBy        User?    @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referralsMade     User[]   @relation("UserReferrals")
  /// Reward days waiting for the client's next subscription (referrer with no plan).
  referralBonusDays Int      @default(0)
  referralsGiven    Referral[] @relation("ReferralReferrer")
  referralReceived  Referral?  @relation("ReferralReferee")

  workoutLogs      WorkoutLog[]
  foodLogs         FoodLog[]
  measurementLogs  MeasurementLog[]
  packagePurchases PackagePurchase[]
  bookPurchases    BookPurchase[]
  callBookings     CallBooking[]
  resetTokens      PasswordResetToken[]
  subscriptions    Subscription[]
  consultationRequests ConsultationRequest[]
}

/// Single-use, hashed password-reset tokens. Only a SHA-256 hash is stored, so
/// a database leak cannot be replayed to take over an account.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model WorkoutLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise String
  sets     Int
  reps     Int
  weightKg Float?
  loggedAt DateTime @default(now())

  @@index([userId, loggedAt])
}

model FoodLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  calories    Int?
  loggedAt    DateTime @default(now())

  @@index([userId, loggedAt])
}

model MeasurementLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weightKg   Float?
  heightCm   Float?
  waistCm    Float?
  shoulderCm Float?
  chestCm    Float?
  armCm      Float?
  loggedAt   DateTime @default(now())

  @@index([userId, loggedAt])
}

model Package {
  id              String            @id @default(cuid())
  title           String
  slug            String            @unique
  description     String
  durationWeeks   Int
  priceKobo       Int
  previewVideoUrl String?
  contents        String[]
  isActive        Boolean           @default(true)
  /// MONTHLY programs are sold as Paystack subscriptions; ONE_OFF as a single charge.
  billingInterval BillingInterval   @default(MONTHLY)
  /// Paystack plan (`pln_…`) used at checkout. A price change creates a new plan.
  paystackPlanCode       String?
  /// The amount the current plan code bills, so a price edit can be detected.
  paystackPlanAmountKobo Int?
  createdAt       DateTime          @default(now())
  purchases       PackagePurchase[]
  subscriptions   Subscription[]
}

/// One live subscription per client per program. Renewals arrive as invoices.
model Subscription {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId        String
  package          Package            @relation(fields: [packageId], references: [id])
  /// Paystack `subscription_code` (SUB_…).
  subscriptionCode String             @unique
  /// Paystack `email_token` — required to cancel or reactivate.
  emailToken       String
  status           SubscriptionStatus @default(ACTIVE)
  amountKobo       Int
  /// End of the paid-for period. Access is granted up to this date.
  currentPeriodEnd DateTime
  nextPaymentDate  DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  invoices         Invoice[]

  @@unique([userId, packageId])
  @@index([status])
  @@index([currentPeriodEnd])
}

/// One row per invited client. `refereeId` is unique, so nobody can be referred twice.
model Referral {
  id          String         @id @default(cuid())
  referrerId  String
  referrer    User           @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId   String         @unique
  referee     User           @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: Cascade)
  /// The code that was used, kept for auditing.
  code        String
  status      ReferralStatus @default(PENDING)
  rewardDays  Int            @default(7)
  qualifiedAt DateTime?
  rewardedAt  DateTime?
  createdAt   DateTime       @default(now())

  @@index([referrerId])
  @@index([status])
}

/// A renewal charge. Doubles as the webhook replay guard: `invoiceCode` is unique.
model Invoice {
  id             String        @id @default(cuid())
  subscriptionId String
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  invoiceCode    String        @unique
  reference      String?
  amountKobo     Int
  status         PaymentStatus @default(PENDING)
  periodStart    DateTime?
  periodEnd      DateTime?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())

  @@index([subscriptionId])
  @@index([status])
}

model PackagePurchase {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId   String
  package     Package       @relation(fields: [packageId], references: [id])
  amountKobo  Int
  paystackRef String        @unique
  status      PaymentStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([userId])
  @@index([status])
}

model Book {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  description String?
  priceKobo   Int
  /// Link to the actual PDF/e-book file (Cloudinary or any host). Null until
  /// the admin pastes the link — the book then shows as "Coming soon" instead
  /// of a broken download.
  fileUrl     String?
  coverUrl    String?
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  purchases   BookPurchase[]
}

model BookPurchase {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId      String
  book        Book          @relation(fields: [bookId], references: [id])
  amountKobo  Int
  paystackRef String        @unique
  status      PaymentStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([userId])
  @@index([status])
}

model EducationContent {
  id           String   @id @default(cuid())
  title        String
  category     String
  videoUrl     String
  thumbnailUrl String?
  createdAt    DateTime @default(now())

  @@index([category])
}

model CoachAvailability {
  id        String       @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  isBooked  Boolean      @default(false)
  booking   CallBooking?

  @@index([startTime])
}

model CallBooking {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  slotId    String            @unique
  slot      CoachAvailability @relation(fields: [slotId], references: [id])
  phone     String?
  notes     String?
  createdAt DateTime          @default(now())

  @@index([userId])
}

/// A home-visit / remote consultation request. The fee is flat (₦20,000) and
/// paid on the call or at the visit — no online charge is taken.
model ConsultationRequest {
  id          String                @id @default(cuid())
  userId      String
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  specialty   ConsultationSpecialty
  mode        ConsultationMode
  phone       String
  /// Required when mode = HOME_VISIT (enforced in the API), optional for VIDEO.
  address     String?
  preferredAt DateTime
  notes       String?
  /// Always ₦20,000 today; stored per-row for a possible future price change.
  amountKobo  Int                   @default(2000000)
  status      ConsultationStatus    @default(PENDING)
  createdAt   DateTime              @default(now())

  @@index([userId, createdAt])
  @@index([status])
  @@index([preferredAt])
}
