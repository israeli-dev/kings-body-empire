# ─────────────────────────────────────────────────────────────
# Kings Body Empire — environment variables
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# --- Database (PostgreSQL) -----------------------------------
# Local Docker:  postgresql://postgres:postgres@localhost:5432/kings_body_empire
# Supabase/Neon: paste the *direct* connection string (port 5432) here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kings_body_empire?schema=public"

# --- Auth (NextAuth) -----------------------------------------
NEXTAUTH_URL="http://localhost:3000"
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"

# --- Seed / first admin account ------------------------------
# `npm run db:seed` creates this admin. Change before deploying!
ADMIN_EMAIL="admin@kingsbodyempire.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Coach King"
# Set to "false" to skip creating the demo client account
SEED_DEMO_CLIENT="true"

# --- Payments (Paystack) — optional --------------------------
# Leave blank to run the app with payments disabled (useful for local testing).
# Test keys: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# --- Site / branding -----------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="hello@kingsbodyempire.com"
NEXT_PUBLIC_WHATSAPP_URL="https://wa.me/2348000000000"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/kingsbodyempire"
# Timezone used for "day" streaks / rank calculations
NEXT_PUBLIC_TIMEZONE="Africa/Lagos"

# --- Media (optional) ----------------------------------------
# Used for hosting e-book files / thumbnails
CLOUDINARY_URL=""
