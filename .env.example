# ─────────────────────────────────────────────────────────────
# Kings Body Empire — environment variables
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# --- Database (PostgreSQL) -----------------------------------
# Local Docker:  postgresql://postgres:postgres@localhost:5432/kings_body_empire
# Supabase:      paste the **connection pooler** string (Project Settings →
#                Database → Connection string → Connection pooling, session
#                mode, port 5432), e.g.
#                  postgresql://postgres.<ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
#                Do NOT use the "Direct connection" host db.<ref>.supabase.co —
#                it is IPv6-only for newer projects and unreachable from hosts.
#                The Project URL and publishable/anon key are for supabase-js
#                and are not used by this app.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kings_body_empire?schema=public"

# --- Auth (NextAuth) -----------------------------------------
# The public URL of the site, with no trailing slash and no path.
#   local:   http://localhost:3000
#   Render:  https://<your-service>.onrender.com
#   Vercel:  https://<your-project>.vercel.app  (or your custom domain)
# If you leave it blank on Render/Vercel the app falls back to
# RENDER_EXTERNAL_URL / VERCEL_URL automatically, but set it explicitly anyway.
NEXTAUTH_URL="http://localhost:3000"
# Generate one with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"

# --- Seed / first admin account ------------------------------
# `npm run db:seed` creates this admin. Change before deploying!
ADMIN_EMAIL="admin@kingsbodyempire.com"
ADMIN_PASSWORD="ChangeMe123!"
ADMIN_NAME="Coach King"
# Set to "false" to skip creating the demo client account
SEED_DEMO_CLIENT="true"

# --- Payments (Paystack) — optional --------------------------
# Leave blank to run the app with payments disabled (useful for local testing).
# Test keys: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=""
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=""

# --- Site / branding -----------------------------------------
# Must match NEXTAUTH_URL. Used for password-reset links and Paystack callbacks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="hello@kingsbodyempire.com"
NEXT_PUBLIC_WHATSAPP_URL="https://wa.me/2348000000000"
NEXT_PUBLIC_INSTAGRAM_URL="https://instagram.com/kingsbodyempire"
# Timezone used for "day" streaks / rank calculations
NEXT_PUBLIC_TIMEZONE="Africa/Lagos"

# --- Email / password reset (optional but recommended) ------
# Without any of these the reset link is printed in the server console
# (perfect for local testing).
#
# Option 1 — Resend (easiest on Vercel/Render):
#   RESEND_API_KEY="re_xxxxxxxx"
# Option 2 — any SMTP provider (Gmail app password, Zoho, Mailtrap…):
#   SMTP_URL="smtp://user:password@smtp.gmail.com:587"
# The From address must be verified by your provider:
EMAIL_FROM="Kings Body Empire <no-reply@your-domain.com>"
RESEND_API_KEY=""
SMTP_URL=""

# --- Media (optional) ----------------------------------------
# Used for hosting e-book files / thumbnails
CLOUDINARY_URL=""
